# Inkloom AI - Environment Configuration Example
# Copy this file to .env and configure your variables

# PostgreSQL Database Connection URL (Prisma ORM)
DATABASE_URL="postgresql://user:password@localhost:5432/inkloom_ai?schema=public"

# Gemini API Key (accessed strictly server-side)
# If omitted or unavailable, the application runs reliably in Deterministic-Only mode
GEMINI_API_KEY=""
